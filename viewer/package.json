{
  "name": "smaky-viewer",
  "version": "0.4.1",
  "description": "Navigateur et visualiseur de disques Smaky extraits (format FOS)",
  "homepage": "https://www.epsitec.ch/",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:linux:tar": "electron-builder --linux tar.gz",
    "dist:mac": "electron-builder --mac"
  },
  "author": {
    "name": "Pierre-Yves Rochat",
    "email": "pyr@pyr.ch"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ch.epsitec.smaky.viewer",
    "productName": "Navigateur Smaky",
    "copyright": "© 2026 Epsitec SA, Pierre-Yves Rochat",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "fosfat.js",
      "extract-worker.js",
      "help.md",
      "renderer/**/*",
      "package.json"
    ],
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb", "tar.gz"], "category": "Utility", "maintainer": "Pierre-Yves Rochat <pyr@pyr.ch>" },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" }
  }
}
